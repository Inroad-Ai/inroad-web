# Where the FastAPI backend is listening. No trailing slash.
# The backend's ALLOWED_ORIGIN must match wherever this frontend runs
# (it defaults to http://localhost:3000, which is also Next's dev default).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional Phase 6 browser telemetry. These browser ingestion identifiers are
# intentionally public (they cannot read telemetry); do not put secrets in a
# NEXT_PUBLIC_ variable. All automatic capture and session replay are off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-rendered error reporting uses this deployment-only value instead.
SENTRY_DSN=
INROAD_ENV=development

# Same HS256 signing secret as inroad-api's JWT_SECRET. Not NEXT_PUBLIC_:
# server-side only (middleware, layouts), never sent to the browser. Used to
# verify an access token's signature locally.
JWT_SECRET=
