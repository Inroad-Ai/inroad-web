# Where the FastAPI backend is listening. No trailing slash.
# The backend's ALLOWED_ORIGIN must match wherever this frontend runs
# (it defaults to http://localhost:3000, which is also Next's dev default).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project credentials for lib/supabase/browser.ts and server.ts,
# and for middleware.ts, which refreshes the session cookie on every request.
# Google OAuth also needs a redirect URI of {this app's origin}/auth/callback
# added in the Supabase Auth provider settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
